# SmartResolve AI - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ============================================================
# DATABASE
# ============================================================
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=smartresolve_db

# ============================================================
# JWT AUTHENTICATION
# Generate a strong secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-64-CHAR-HEX-KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# CORS ORIGINS (comma-separated, or JSON array string)
# Add your frontend URL here.
# ============================================================
CORS_ORIGINS_STR=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT=20/minute

# ============================================================
# ML MODEL
# ============================================================
CONFIDENCE_THRESHOLD=0.60

# Municipal case portal
MYSQL_PORT=3306
CASE_PUBLIC_DEPLOYMENT=false
# Map staff usernames to individual Base32 authenticator secrets. Store real values in a secret manager.
CASE_STAFF_TOTP_SECRETS={}
# Both settings are required to offer SMS. Set only when the gateway is provisioned.
CASE_SMS_WEBHOOK=
CASE_SMS_TOKEN=
