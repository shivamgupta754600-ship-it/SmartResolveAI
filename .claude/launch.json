{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "smartresolve-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "url": "http://localhost:5173",
      "cwd": "frontend-react"
    },
    {
      "name": "smartresolve-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
      "port": 8000,
      "url": "http://localhost:8000"
    }
  ]
}
